{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@charlesnutter/opencode-hud",
  "version": "0.1.0",
  "description": "Live local-inference stats (MTPLX, oMLX) pinned to the OpenCode sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "hud",
    "mtplx",
    "omlx",
    "mlx",
    "tokens-per-second",
    "ttft"
  ],
  "license": "MIT",
  "author": "charlesnutter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesnutter/opencode-hud.git"
  },
  "homepage": "https://github.com/charlesnutter/opencode-hud#readme",
  "bugs": {
    "url": "https://github.com/charlesnutter/opencode-hud/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./tui.tsx"
    },
    "./tui": {
      "import": "./tui.tsx"
    }
  },
  "engines": {
    "opencode": ">=1.18.20"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.18.20",
    "typescript": "^5.6.0"
  },
  "files": [
    "tui.tsx",
    "prometheus.ts",
    "koboldcpp.ts",
    "universal.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test/prometheus.test.mjs && bun test/koboldcpp.test.mjs && bun test/universal.test.mjs"
  }
}
