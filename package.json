{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@banburist/opencode-engine-hud",
  "version": "0.1.1",
  "description": "Live local-inference telemetry (tok/s, TTFT, prefill) pinned to the OpenCode sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "hud",
    "telemetry",
    "tokens-per-second",
    "ttft",
    "llama.cpp",
    "vllm",
    "sglang",
    "koboldcpp",
    "mlx",
    "mtplx",
    "omlx"
  ],
  "license": "MIT",
  "author": "charlesnutter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesnutter/opencode-engine-hud.git"
  },
  "homepage": "https://github.com/charlesnutter/opencode-engine-hud#readme",
  "bugs": {
    "url": "https://github.com/charlesnutter/opencode-engine-hud/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./tui.tsx"
    }
  },
  "engines": {
    "opencode": ">=1.18.0"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.0",
    "@opencode-ai/sdk": "1.18.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "tui.tsx",
    "format.ts",
    "http.ts",
    "prometheus-text.ts",
    "universal.ts",
    "adapters/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && bun test/format.test.mjs && bun test/http.test.mjs && bun test/prometheus-text.test.mjs && bun test/universal.test.mjs && bun test/mtplx.test.mjs && bun test/omlx.test.mjs && bun test/llamacpp.test.mjs && bun test/prometheus.test.mjs && bun test/koboldcpp.test.mjs && bun test/splash.test.mjs && bun test/mlxserve.test.mjs && bun test/references.test.mjs"
  }
}
